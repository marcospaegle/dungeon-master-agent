# Copy to .env.eval. Read after .env by `uv run python -m evals`, so
# these override it for evals only; variables already set in the shell
# win over both.
# DUNGEON_PROVIDER=anthropic
# DUNGEON_MODEL=claude-sonnet-5-5
# The judge that grades transcripts is set apart from the model under
# test. They default to DUNGEON_PROVIDER and DUNGEON_MODEL.
# EVAL_JUDGE_PROVIDER=anthropic
# EVAL_JUDGE_MODEL=claude-sonnet-5-5
